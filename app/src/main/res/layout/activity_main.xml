<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Now playing: a small clock above [ "previous" zone ] [ album cover: tap = play/pause ] [ "next" zone ] -->
    <FrameLayout
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/playerRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/prevZone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Previous track"
                android:focusable="true"
                android:soundEffectsEnabled="false" />

            <ImageView
                android:id="@+id/cover"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="56dp"
                android:layout_marginBottom="56dp"
                android:adjustViewBounds="true"
                android:clickable="true"
                android:contentDescription="Album cover. Tap to play or pause"
                android:focusable="true"
                android:scaleType="fitCenter"
                android:soundEffectsEnabled="false" />

            <View
                android:id="@+id/nextZone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Next track"
                android:focusable="true"
                android:soundEffectsEnabled="false" />
        </LinearLayout>

        <TextClock
            android:id="@+id/playerClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/jakarta_medium"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:importantForAccessibility="no"
            android:shadowColor="#66000000"
            android:shadowRadius="8"
            android:textColor="#FFFFFF"
            android:textSize="22dp" />
    </FrameLayout>

    <!-- Home screen, shown when nothing is playing: [ last played ]  clock  [ next F1 session ] -->
    <FrameLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/clockBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="54dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jakarta_extralight"
                android:includeFontPadding="false"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="128dp" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jakarta_regular"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:textColor="#B3FFFFFF"
                android:textSize="20dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lastPlayed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="36dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/lastArt"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lastLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_regular"
                    android:text="Last played"
                    android:textColor="#B3FFFFFF"
                    android:textSize="16dp" />

                <TextView
                    android:id="@+id/lastTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/jakarta_medium"
                    android:maxLines="1"
                    android:maxWidth="255dp"
                    android:textColor="#FFFFFF"
                    android:textSize="27dp" />

                <TextView
                    android:id="@+id/lastArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/jakarta_regular"
                    android:maxLines="1"
                    android:maxWidth="255dp"
                    android:textColor="#D9FFFFFF"
                    android:textSize="20dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nextSession"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="36dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/nextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jakarta_regular"
                android:text="Next session"
                android:textColor="#B3FFFFFF"
                android:textSize="16dp" />

            <TextView
                android:id="@+id/nextName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta_regular"
                android:maxLines="1"
                android:maxWidth="285dp"
                android:textColor="#D9FFFFFF"
                android:textSize="20dp" />

            <TextView
                android:id="@+id/nextCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jakarta_regular"
                android:fontFeatureSettings="tnum"
                android:textColor="#FFFFFF"
                android:textSize="30dp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/jakarta_regular"
        android:gravity="center"
        android:textColor="#AAAAAA"
        android:textSize="26sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/connect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="140dp"
        android:fontFamily="@font/jakarta_medium"
        android:padding="20dp"
        android:text="Connect Spotify"
        android:textSize="22sp"
        android:visibility="gone" />

    <!-- Live F1 dashboard: covers everything else while a session is on. Long-press to hide it
         until the next session. -->
    <LinearLayout
        android:id="@+id/f1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:orientation="horizontal"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5">

            <com.echocover.TrackMapView
                android:id="@+id/f1Map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="88dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/f1Event"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_regular"
                    android:letterSpacing="0.08"
                    android:textColor="#8C8C8C"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/f1Lap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_medium"
                        android:textColor="#FFFFFF"
                        android:textSize="40sp" />

                    <TextView
                        android:id="@+id/f1Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:fontFamily="@font/jakarta_medium"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:letterSpacing="0.05"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <com.echocover.LeaderboardView
            android:id="@+id/f1Board"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingTop="16dp"
            android:paddingEnd="32dp"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:elevation="24dp"
        android:visibility="gone" />
</FrameLayout>
