<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Cleartext is allowed for the F1 dashboard's own server (plain http). Spotify calls are
         all https URLs, so they are unaffected. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- To make this the device's home screen, also add:
                     <category android:name="android.intent.category.HOME" />
                     <category android:name="android.intent.category.DEFAULT" /> -->
            </intent-filter>

            <!-- Spotify login redirect: echocover://callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="echocover" android:host="callback" />
            </intent-filter>
        </activity>
    </application>
</manifest>
